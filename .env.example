# 环境配置模板：复制为 .env 后填入真实值（.env 不入库）

# 服务端口（修改后需重启后端服务）
APP_PORT=3000

# PostgreSQL 数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=issue_tracker
POSTGRES_USER=issue
POSTGRES_PASSWORD=
PG_POOL_MAX=20

# Redis 可选缓存
REDIS_ENABLED=0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
